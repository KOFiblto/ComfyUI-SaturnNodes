# ComfyUI-SaturnNodes Environment Configuration Example
# Copy or rename this file to .env to configure custom API keys and default behaviors.
# Runtime location: ComfyUI/user/default/SaturnNodes/.env

# Optional Civitai API Key for auto-downloading LoRA preview thumbnails
CIVITAI_API_KEY=

# Optional TMDB API Key / Read Access Token for actor / media preview image search
TMDB_API_KEY=

# Feature toggles
ENABLE_CIVITAI_SCRAPING=false
ENABLE_TMDB_SCRAPING=false
ENABLE_LORA_USAGE=true
ENABLE_PERSISTENT_QUEUE=true
ENABLE_TRAY_ICON=false
ENABLE_ASSETS_RESTORE=true
RESTORE_ASSETS_COUNT=64
RESTORE_ASSETS_RECURSIVE=true
SHOW_RESTORED_GENERATION_TIME=true

# Visual image loader metadata scanning (0 disables prompt extraction)
IMAGE_LOADER_METADATA_LIMIT=128

# Launch defaults
DEFAULT_PAUSE_STATE=Running
DEFAULT_PAUSE_MODE=after_finish
PERSISTENT_QUEUE_RESTORED_STATE=Match Default
PERSISTENT_QUEUE_MAX_RETRIES=0
PERSIST_PAUSE_STATE=false

# Prompt iterator privacy
CLEAR_PROMPT_ITERATOR_ON_LAUNCH=false

# Security gates (opt-in, both disabled by default)
ALLOW_PROCESS_MANAGEMENT=false
ENABLE_LOCAL_FILE_EXECUTION=false
